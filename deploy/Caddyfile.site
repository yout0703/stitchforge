# Import this file from /etc/caddy/Caddyfile. Existing loopback sites are preserved.
# Bind this host's public interface explicitly, avoiding the existing loopback listeners.
http://stichforge.0703.pro {
    bind 177.2.186.10
    redir https://stichforge.0703.pro{uri} permanent
}

https://stichforge.0703.pro {
    bind 177.2.186.10
    tls /etc/caddy/stitchforge-tls/origin.pem /etc/caddy/stitchforge-tls/origin.key
    encode gzip
    request_body {
        max_size 32MB
    }
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
    }
    # Only a Cloudflare peer may supply CF-Connecting-IP. Other clients get
    # Caddy's default, sanitized client address instead of a spoofable header.
    @cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    handle @cloudflare {
        reverse_proxy 127.0.0.1:18765 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }
    handle {
        reverse_proxy 127.0.0.1:18765
    }
    log {
        output file /var/log/caddy/stitchforge-access.log {
            roll_size 10mb
            roll_keep 3
        }
    }
}
