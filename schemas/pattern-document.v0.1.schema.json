{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stitchforge:schema:pattern-document:0.1.0",
  "title": "StitchForge PatternDocument v0.1.0",
  "description": "全针设计契约。跨字段引用、数组形状、锁定、材料来源和发布门禁必须另按 docs/data-contract.md 校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "required_features",
    "metadata",
    "grid",
    "fabric",
    "materials",
    "recipes",
    "full_stitches",
    "regions",
    "legend",
    "constraints",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "required_features": {
      "type": "array",
      "prefixItems": [
        {
          "const": "full_cross"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "grid": {
      "$ref": "#/$defs/grid"
    },
    "fabric": {
      "$ref": "#/$defs/fabric"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "full_stitches": {
      "$ref": "#/$defs/fullStitches"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "legend": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legendEntry"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/annotationValue"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "title",
        "author",
        "created_at",
        "purpose"
      ],
      "properties": {
        "pattern_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "author": {
          "type": "string",
          "maxLength": 256
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "enum": [
            "user_design",
            "test_fixture"
          ]
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "origin",
        "subgrid_scale"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "origin": {
          "const": "top_left"
        },
        "subgrid_scale": {
          "const": 2
        }
      }
    },
    "fabric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "count",
        "count_unit",
        "worked_over",
        "display_srgb",
        "margins_mm"
      ],
      "properties": {
        "type": {
          "const": "aida"
        },
        "count": {
          "type": "integer",
          "minimum": 6,
          "maximum": 40
        },
        "count_unit": {
          "const": "cells_per_inch"
        },
        "worked_over": {
          "const": 1
        },
        "display_srgb": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "margins_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "properties": {
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "right": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "brand",
        "series",
        "code",
        "name",
        "color"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_srgb",
            "status",
            "source_ref"
          ],
          "properties": {
            "display_srgb": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#[0-9A-F]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "approximate",
                "measured",
                "synthetic",
                "unknown"
              ]
            },
            "source_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "material_id",
              "strands"
            ],
            "properties": {
              "material_id": {
                "$ref": "#/$defs/id"
              },
              "strands": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            }
          },
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "fullStitches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "top_leg",
        "cells"
      ],
      "properties": {
        "encoding": {
          "const": "row-major-u16"
        },
        "top_leg": {
          "enum": [
            "slash",
            "backslash"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 1,
          "maxItems": 360000
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "start_col",
        "end_col"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 599
        },
        "start_col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 599
        },
        "end_col": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "policy",
        "spans"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "enum": [
            "editable",
            "preserve",
            "locked"
          ]
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "maxItems": 360000
        }
      }
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "symbol_id"
      ],
      "properties": {
        "recipe_id": {
          "$ref": "#/$defs/id"
        },
        "symbol_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locator",
        "description",
        "permission_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "permission_status": {
          "enum": [
            "unverified",
            "private_use",
            "redistributable",
            "restricted"
          ]
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color_budget",
        "metric_profile"
      ],
      "properties": {
        "color_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "metric_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_asset_hashes",
        "engine_version",
        "catalog_snapshot_id",
        "rule_profile",
        "generation_config_hash",
        "random_seed",
        "ai_proposal_hash",
        "sources"
      ],
      "properties": {
        "source_asset_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "rule_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation_config_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "ai_proposal_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "maxItems": 4096
        }
      }
    },
    "annotationValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/annotationValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": {
            "$ref": "#/$defs/annotationValue"
          }
        }
      ]
    }
  }
}
