# stitchforge-api 从启动目录自动读取 .env；已有进程环境变量优先。
STITCHFORGE_DATA_DIR=.stitchforge-data
# 默认随 API 启动图片 worker；单独运行 uv run stitchforge-worker 时设为 0。
STITCHFORGE_WORKER_ENABLED=1
# 图片分析：deepseek / local / codex
STITCHFORGE_AI_PROVIDER=deepseek
# 在项目根目录 .env 填写真实 Key，勿填入前端 VITE_* 变量。
DEEPSEEK_API_KEY=
# DeepSeek-V4.1-Flash 的官方 API 模型 ID
STITCHFORGE_DEEPSEEK_MODEL=deepseek-flash
STITCHFORGE_DEEPSEEK_TIMEOUT=60
STITCHFORGE_CODEX_ENABLED=0
# PNG 中文图纸字体：Linux 部署安装 Noto Sans CJK；也可指定支持中文的 TTF/TTC 文件。
# STITCHFORGE_CHART_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 公开部署时设置实际的 HTTPS 来源（不带路径），启用 Secure Cookie
# STITCHFORGE_PUBLIC_ORIGIN=https://stitch.example.com
# 套餐价格由经营者决定。默认无套餐；配置套餐不会自动启用真实收款。
STITCHFORGE_CREDIT_PACKS=[]

# 按商户实际开通情况独立启用；默认全部关闭。
STITCHFORGE_WECHAT_ENABLED=0
STITCHFORGE_WECHAT_H5_ENABLED=0
# STITCHFORGE_WECHAT_APP_ID=YOUR_APP_ID
# STITCHFORGE_WECHAT_MCH_ID=YOUR_MERCHANT_ID
# STITCHFORGE_WECHAT_CERT_SERIAL=YOUR_MERCHANT_CERTIFICATE_SERIAL
# STITCHFORGE_WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat_private.pem
# STITCHFORGE_WECHAT_API_V3_KEY_FILE=/run/secrets/wechat_api_v3_key
# STITCHFORGE_WECHAT_PUBLIC_KEY_ID=PUB_KEY_ID_YOUR_ID
# STITCHFORGE_WECHAT_PUBLIC_KEYS_JSON={"PUB_KEY_ID_YOUR_ID":"/run/secrets/wechat_public.pem"}

STITCHFORGE_ALIPAY_ENABLED=0
STITCHFORGE_ALIPAY_SANDBOX=0
# 使用官方 SDK 的本地时间戳，启用支付宝时进程时区设为 Asia/Shanghai。
TZ=Asia/Shanghai
# STITCHFORGE_ALIPAY_APP_ID=YOUR_APP_ID
# STITCHFORGE_ALIPAY_SELLER_ID=YOUR_SELLER_ID
# STITCHFORGE_ALIPAY_MODES=page,wap
# STITCHFORGE_ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay_private.pem
# STITCHFORGE_ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_public.pem

STITCHFORGE_STRIPE_ENABLED=0
# STITCHFORGE_STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
# STITCHFORGE_STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret
